[Unit]
Description=Arctis Nova 5X battery tray and ChatMix
After=pipewire.service pipewire-pulse.service graphical-session.target
# Restart with PipeWire so the wheel mix is re-applied to the new loopback streams.
PartOf=graphical-session.target pipewire.service pipewire-pulse.service

[Service]
ExecStart=%h/.cargo/bin/arctisd
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
